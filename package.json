{
  "name": "pulso",
  "version": "1.0.0",
  "private": true,
  "description": "Pulso - financas pessoais simples (Cloudflare Workers + D1 + R2)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply pulso-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply pulso-db --remote"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "devDependencies": {
    "wrangler": "latest"
  }
}